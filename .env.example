# Global Environment Configuration
NODE_ENV=development

# NestJS Backend API Configuration
PORT=4000
DATABASE_URL=postgresql://brewlite:secret@localhost:5432/brewlite_db?schema=public
JWT_SECRET=brewlite_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d

# Next.js Frontend Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# SePay Configuration (Auto-Sync Polling)
SEPAY_API_TOKEN=
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=secret
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432
