@startuml class-domain
title BrewLite - Domain Class Diagram (Task 2.3 - Phụ trách: Chính 2)
skinparam classAttributeIconSize 0

enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum LoyaltyTxType {
  EARN
  REDEEM
}

class User {
  +id: UUID
  +email: String
  +passwordHash: String
  +fullName: String
  +phone: String
  +role: UserRole
  +loyaltyPoints: Integer
  +createdAt: DateTime
}

class Product {
  +id: UUID
  +name: String
  +description: String
  +category: String
  +basePrice: Decimal
  +imageUrl: String
  +sizeOptions: JSON
  +toppingOptions: JSON
  +stockQuantity: Integer
  +isAvailable: Boolean
  +createdAt: DateTime
}

class Order {
  +id: UUID
  +orderCode: String
  +status: OrderStatus
  +subtotalAmount: Decimal
  +discountAmount: Decimal
  +totalAmount: Decimal
  +note: String
  +createdAt: DateTime
  +updatedAt: DateTime
}

class OrderItem {
  +id: UUID
  +size: String
  +selectedToppings: JSON
  +quantity: Integer
  +unitPrice: Decimal
  +lineTotal: Decimal
}

class Payment {
  +id: UUID
  +idempotencyKey: String
  +method: PaymentMethod
  +status: PaymentStatus
  +amount: Decimal
  +transactionRef: String
  +paidAt: DateTime
  +createdAt: DateTime
}

class Promotion {
  +id: UUID
  +code: String
  +description: String
  +discountPercent: Decimal
  +maxDiscountAmount: Decimal
  +validFrom: DateTime
  +validUntil: DateTime
  +isActive: Boolean
}

class LoyaltyTransaction {
  +id: UUID
  +points: Integer
  +type: LoyaltyTxType
  +description: String
  +createdAt: DateTime
}

User "1" -- "0..*" Order : places >
Order "1" *-- "1..*" OrderItem : contains >
Product "1" -- "0..*" OrderItem : referenced in >
Order "1" -- "0..*" Payment : paid via >
Promotion "0..1" -- "0..*" Order : applied to >
User "1" -- "0..*" LoyaltyTransaction : owns >
Order "0..1" -- "0..*" LoyaltyTransaction : triggers >
@enduml
