@startuml usecase-checkout
left to right direction
skinparam packageStyle rectangle

title BrewLite - Focused Use-Case Diagram: Đặt và Thanh toán Đơn hàng (UC-05)

actor "Khách hàng\n(Customer)" as Customer

rectangle "BrewLite - Hệ thống Đặt và Thanh toán Đơn hàng" {

  usecase "Đặt và thanh toán\nđơn hàng" as UC_Main

  usecase "Xác thực JWT\nToken" as UC_Auth

  usecase "Kiểm tra & trừ\ntồn kho" as UC_Stock

  usecase "Xử lý thanh toán\n(WALLET / CARD)" as UC_Pay

  usecase "Kiểm tra\nIdempotency-Key" as UC_Idempotency

  usecase "Hoàn lại tồn kho\nkhi thanh toán thất bại" as UC_Rollback

  usecase "Áp dụng mã\ngiảm giá" as UC_Promo

  UC_Main ..> UC_Auth : <<include>>
  UC_Main ..> UC_Stock : <<include>>
  UC_Main ..> UC_Pay : <<include>>

  UC_Pay ..> UC_Idempotency : <<include>>

  UC_Rollback ..> UC_Pay : <<extend>>\n[Thanh toán thất bại]

  UC_Promo ..> UC_Main : <<extend>>\n[Có nhập mã]
}

Customer --> UC_Main

@enduml
